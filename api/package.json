  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsc-watch --onSuccess \\\"node --env-file=.env dist/server.js\\\"\" \"tsc-alias -w\" | pino-pretty",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "migrate:objectid": "npm run build && node --env-file=.env dist/scripts/migrate-objectid.js",
    "db:explain": "npm run build && node --env-file=.env dist/scripts/mongo-explain.js",
    "test:schema": "npm run build && node dist/scripts/schema-smoke-test.js"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^25.2.3",
    "@types/pino": "^7.0.4",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "mongoose": "^9.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
